     "type": "query",
     "key": "og"
    }
   ],
   "destination": "/api/og?kind=product&store=:store&product=:product"
  },
  {
   "source": "/((?!api/|assets/|css/|js/|sw\\.js|manifest\\.webmanifest|offline\\.html|robots\\.txt|sitemap\\.xml).*)",
   "destination": "/index.html"
  }
 ],
 "headers": [
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=86400"
    }
   ]
  }
 ]
}